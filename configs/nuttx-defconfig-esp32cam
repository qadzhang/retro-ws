#
# ESP32-CAM 复古图形工作站 - NuttX 追加配置
# 基于 esp32-devkitc:nsh 基础配置，追加硬件特定选项
#

# ===== CPU & SMP =====
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2

# ===== Flash & PSRAM =====
CONFIG_ESP32_FLASH_FREQ_40M=y
CONFIG_ESP32_IRAM_HEAP=y
CONFIG_ESP32_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_ESP32_SPIRAM_RODATA=y

# ===== RT Timer (rtc.c 需要) =====
CONFIG_ESP32_RT_TIMER=y

# ===== SPI2 (SD card on ESP32-CAM) =====
CONFIG_ESP32_SPI2=y

# ===== Network late init (no Ethernet PHY) =====
CONFIG_NETDEV_LATEINIT=y

# ===== System =====
CONFIG_NSH_READLINE=y
CONFIG_NSH_LINELEN=256

# ===== File System =====
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FS_PROCFS=y

# ===== MMC/SD via SPI =====
CONFIG_MMCSD=y
CONFIG_MMCSD_SPI=y

# ===== Watchdog =====
CONFIG_WATCHDOG=y
CONFIG_ESP32_WDT=y

# ===== RTC =====
CONFIG_RTC=y
CONFIG_RTC_DRIVER=y

# ===== I2C =====
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y

# ===== SPI =====
CONFIG_SPI=y
CONFIG_SPI_DRIVER=y

# ===== DMA =====
CONFIG_DMA=y

# ===== PWM =====
CONFIG_PWM=y

# ===== Build Options =====
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200

# ===== Debug =====
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_SYMBOLS=y
