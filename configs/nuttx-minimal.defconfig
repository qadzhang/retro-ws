#
# ESP32-S3 NuttX 最小配置 (无需外部下载)
# NuttX 12.12.0 + ESP-IDF v5.5.4
#

# ===== 架构 =====
CONFIG_ARCH="xtensa"
CONFIG_ARCH_XTENSA=y
CONFIG_ARCH_BOARD="esp32s3-devkit"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32S3_DEVKIT=y
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESPRESSIF=y
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ESPRESSIF_CHIP_SERIES=esp32s3
CONFIG_ARCH_FAMILY_LX7=y
CONFIG_XTENSA_TOOLCHAIN_ESP=y

# ===== Boot Format =====
CONFIG_ESPRESSIF_SIMPLE_BOOT=y

# ===== Idle Thread =====
CONFIG_IDLETHREAD_STACKSIZE=2048

# ===== Flash Timing =====
CONFIG_ESP32S3_FLASH_FREQ_40M=y

# CPU 配置
CONFIG_ESP32S3_CPU_FREQ_240=y
CONFIG_BOARD_LOOPS_PER_SEC=240000000
CONFIG_BOARD_LOOPSPERMSEC=16717

# 双核 SMP
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2
CONFIG_SPINLOCK=y
CONFIG_SCHED_CPULOAD=y
CONFIG_ARCH_HAVE_TESTSET=y

# Flash & PSRAM
CONFIG_ESP32S3_FLASH_16MB=y
CONFIG_ESP32S3_FLASH_SIZE="16MB"
CONFIG_ESP32S3_PSRAM_8MB=y
CONFIG_ESP32S3_PSRAM_SIZE="8MB"
CONFIG_SPIRAM=y

# NuttX 内核
CONFIG_NUTTX=y
CONFIG_VERSION_STRING="12.12.0"
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_STACK_USAGE_WARNING=0

# 系统
CONFIG_SYS_USR=y
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_CXX=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_LINELEN=256
CONFIG_NSH_PROMPT_MAX=64

# 文件系统 (禁用 littlefs)
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FS_PROCFS=y

# 网络 (简化)
CONFIG_NET=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_ICMP=y

# 驱动
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_SPI=y
CONFIG_WATCHDOG=y
CONFIG_WDT=y
CONFIG_ESP32S3_WDT=y
CONFIG_RTC=y
CONFIG_RTC_DRIVER=y
CONFIG_RTC_FUNCTIONS=y

# C 库
CONFIG_LIBC_FLOATINGPOINT=y

# 调试 (最小化 - 仅错误和警告)
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y

# 构建
CONFIG_HOST_LINUX=y
CONFIG_BUILD_FLAT=y
CONFIG_RAW_BINARY=y
CONFIG_HAVE_LONG_LONG=y

# 工具链
CONFIG_ARCH_TOOLCHAIN_GNU=y

# 调度
CONFIG_RR_INTERVAL=200
