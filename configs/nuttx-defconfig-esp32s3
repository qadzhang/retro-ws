#
# ESP32-S3 复古图形工作站 - NuttX 完整配置
# NuttX 12.12.0 + ESP-IDF v5.5.4
#

CONFIG_ARCH="xtensa"
CONFIG_ARCH_BOARD="esp32s3-devkit"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32S3_DEVKIT=y
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESPRESSIF=y
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ESPRESSIF_CHIP_SERIES=esp32s3
CONFIG_ARCH_FAMILY_LX7=y
CONFIG_ARCH_XTENSA=y
CONFIG_XTENSA_TOOLCHAIN_ESP=y

# ===== Boot Format =====
CONFIG_ESPRESSIF_SIMPLE_BOOT=y

# ===== Idle Thread =====
CONFIG_IDLETHREAD_STACKSIZE=2048

# ===== Flash Timing =====
CONFIG_ESP32S3_FLASH_FREQ_40M=y

# ===== CPU 配置 =====
CONFIG_ESP32S3_CPU_FREQ_240=y
CONFIG_BOARD_LOOPS_PER_SEC=240000000
CONFIG_BOARD_LOOPSPERMSEC=16717

# ===== 双核 SMP =====
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2
CONFIG_SPINLOCK=y
CONFIG_SCHED_CPULOAD=y
CONFIG_ARCH_HAVE_TESTSET=y

# ===== Flash & PSRAM =====
CONFIG_ESP32S3_FLASH_16MB=y
CONFIG_ESP32S3_FLASH_SIZE="16MB"
CONFIG_ESP32S3_PSRAM_8MB=y
CONFIG_ESP32S3_PSRAM_SIZE="8MB"
CONFIG_SPIRAM=y

# ===== NuttX 内核 =====
CONFIG_NUTTX=y
CONFIG_VERSION_STRING="12.12.0"
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_STACK_USAGE_WARNING=0
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_SCHED=y
CONFIG_DEBUG_SCHED_CRITMONITOR=y
CONFIG_DEBUG_MM=y

# ===== 系统 =====
CONFIG_SYS_USR=y
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_CXX=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_LINELEN=256
CONFIG_NSH_PROMPT_MAX=64

# ===== 文件系统 =====
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FAT_MAXFILESIZE=16777216
# CONFIG_FS_LITTLEFS is not set
CONFIG_FS_PROCFS=y

# ===== 网络 =====
CONFIG_NET=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_ICMP=y
CONFIG_NET_IGMP=y
CONFIG_NET_STATISTICS=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_SOLINGER=y
CONFIG_NET_PKT=y

# ===== WiFi =====
CONFIG_ESP32S3_WIFI=y
CONFIG_ESP32_WIFI=y
CONFIG_WPA2_PSK=y

# ===== 驱动 =====
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_SPI=y
CONFIG_SDIO_DMA=y
CONFIG_MMCSD=y
CONFIG_WATCHDOG=y
CONFIG_WDT=y
CONFIG_ESP32S3_WDT=y
CONFIG_GPIO_IRQ=y
CONFIG_I2S=y
CONFIG_ESP32S3_I2S=y
CONFIG_ADC=y
CONFIG_RTC=y
CONFIG_RTC_DRIVER=y
CONFIG_RTC_FUNCTIONS=y
CONFIG_PWM=y
CONFIG_DMA=y

# ===== LVGL =====
CONFIG_LVGL=y
CONFIG_LVGL_USE_ASSETS_MANAGER=y

# ===== 复古工作站模块 =====
CONFIG_ESP32_RETRO=y

# 显示
CONFIG_RETRO_DISPLAY=y
CONFIG_RETRO_DISPLAY_WIDTH=640
CONFIG_RETRO_DISPLAY_HEIGHT=480
CONFIG_RETRO_DISPLAY_REFR_RATE=60
CONFIG_RETRO_DISPLAY_PALETTE_SIZE=256

# 音频
CONFIG_RETRO_AUDIO=y
CONFIG_RETRO_AUDIO_I2S=0
CONFIG_RETRO_AUDIO_SAMPLE_RATE=44100

# FSK 磁带机
CONFIG_RETRO_FSK=y
CONFIG_RETRO_FSK_BAUD=4800
CONFIG_RETRO_FSK_LOGIC0_FREQ=4800
CONFIG_RETRO_FSK_LOGIC1_FREQ=9600

# RTC
CONFIG_RETRO_RTC=n

# WiFi
CONFIG_RETRO_WIFI=y
CONFIG_RETRO_WIFI_SSID=""
CONFIG_RETRO_WIFI_PASSWORD=""

# NTP
CONFIG_RETRO_NTP=y
CONFIG_RETRO_NTP_SERVER="ntp.aliyun.com"

# 网络
CONFIG_RETRO_NET=y

# 防火墙
CONFIG_ESP32_RETRO_FIREWALL=y

# 内存监控
CONFIG_ESP32_RETRO_MEMMON=y

# Cron
CONFIG_RETRO_CRON=y
CONFIG_SCHED_CRON=y
CONFIG_CRON_CRONTAB="/sdcard/etc/crontab"
CONFIG_CRON_LOG="/sdcard/logs/cron.log"

# USB HID
CONFIG_ESP32_USB=y

# 脚本引擎
CONFIG_ESP32_RETRO_SCRIPTS=y
CONFIG_LVGL_USE_MICROPYTHON=y
CONFIG_LVGL_USE_TINYBASIC=y
CONFIG_LVGL_USE_DUKTAPE=y

# 网络工具
CONFIG_NETUTILS_CURL=y
CONFIG_NETUTILS_WGET=y
CONFIG_NETUTILS_NTPCLIENT=y
CONFIG_SYSTEM_PING=y

# C 库
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIBC_HEIMALLOCATION=y
CONFIG_MALLOC=y
CONFIG_SMART=y
CONFIG_MM_REGIONS=2

# 调试
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_ASSERT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_MM=y

# ===== 构建选项 =====
CONFIG_HOST_LINUX=y
CONFIG_BUILD_FLAT=y
CONFIG_RAW_BINARY=y
CONFIG_INT128=y
CONFIG_HAVE_LONG_LONG=y

# ===== LibC Stream Buffers =====
CONFIG_STREAM_OUT_BUFFER_SIZE=64
CONFIG_STREAM_HEXDUMP_BUFFER_SIZE=128
CONFIG_STREAM_BASE64_BUFFER_SIZE=128

# ===== LibC Exit Functions =====
CONFIG_LIBC_MAX_EXITFUNS=0

# ===== File Descriptors =====
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK=8

# ===== Scheduling =====
CONFIG_RR_INTERVAL=200

# ===== Signal =====
CONFIG_SIG_PREALLOC_ACTIONS=4

# ===== OPTEE (Disabled) =====
# CONFIG_DEV_OPTEE is not set

# ===== 优化 =====
CONFIG_DEBUG_NOOPT=y
CONFIG_DEBUG_SYMBOLS=y

# ============================================
# Dynamic Loading / ELF Support
# ============================================
CONFIG_BINFMT_LOADABLE=y
CONFIG_ELF=y
CONFIG_ELF_STACKSIZE=8192
CONFIG_BINFMT_STORE_FILENAME=y
