#
# ESP32-CAM 复古图形工作站 - NuttX 完整配置
# 基于 nsh defconfig + 自定义配置
# NuttX 12.12.0 + ESP-IDF v5.5.4
#

CONFIG_ARCH="xtensa"
CONFIG_ARCH_BOARD="esp32-devkitc"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32_DEVKITC=y
CONFIG_ARCH_CHIP="esp32"
CONFIG_ARCH_CHIP_ESP32=y
CONFIG_ARCH_CHIP_ESPRESSIF=y
CONFIG_ARCH_CHIP_ESP32WROVER=y
CONFIG_ARCH_FAMILY_LX6=y
CONFIG_ARCH_XTENSA=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_XTENSA_TOOLCHAIN_ESP=y

# Boot
CONFIG_ESPRESSIF_SIMPLE_BOOT=y

# Idle Thread
CONFIG_IDLETHREAD_STACKSIZE=2048

# Flash & PSRAM (ESP32-CAM: 4MB Flash, 4MB PSRAM)
CONFIG_ESP32_FLASH_4M=y
CONFIG_ESP32_FLASH_FREQ_40M=y
CONFIG_ESP32_PSRAM_8M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MODE_OCT=y

# ESP32 Heap Configuration (required for text heap)
CONFIG_ESP32_IRAM_HEAP=y

# CPU (ESP32-CAM: LX6 Dual-core 240MHz)
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ARCH_CPUINFO_FREQ_KHZ=240000
CONFIG_BOARD_LOOPS_PER_SEC=240000000
CONFIG_BOARD_LOOPSPERMSEC=16717

# SMP
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2
CONFIG_SPINLOCK=y
CONFIG_IRQCOUNT=y
CONFIG_SCHED_CPULOAD=y
CONFIG_SCHED_CPULOAD_TIMECONSTANT=100
CONFIG_SCHED_PROFILE_TICKSPERSEC=100
CONFIG_ARCH_HAVE_TESTSET=y
CONFIG_SMP_DEFAULT_CPUSET=0
CONFIG_ARCH_HAVE_MULTICPU=y

# NuttX Kernel
CONFIG_NUTTX=y
CONFIG_VERSION_STRING="12.12.0"
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INIT_STACKSIZE=3072
CONFIG_STACK_USAGE_WARNING=0
CONFIG_SYS_USR=y

# Debug
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_SCHED=y
CONFIG_DEBUG_SCHED_CRITMONITOR=y
CONFIG_DEBUG_MM=y
CONFIG_DEBUG_ERROR=y
CONFIG_DEBUG_WARN=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_ASSERT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEBUG_NOOPT=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_BUILTIN=y
CONFIG_INTELHEX_BINARY=y

# System
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_LPWORK=y
CONFIG_EXPERIMENTAL=y
CONFIG_LIB_ZLIB=y
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_CXX=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_LINELEN=256
CONFIG_NSH_PROMPT_MAX=64
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_ALIAS=y
CONFIG_NSH_CMCRP=y

# Board Control
CONFIG_BOARDCTL_ROMDISK=y

# File System
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FAT_MAXFILESIZE=16777216
CONFIG_FAT_MAXFNAME=255
CONFIG_NAME_MAX=255
CONFIG_FS_PROCFS=y
CONFIG_FS_LOCK_BUCKET_SIZE=0
CONFIG_FS_BACKTRACE=0
CONFIG_FS_NEPOLL_DESCRIPTORS=8
CONFIG_FS_MQUEUE_VFS_PATH="/dev/mqueue"
CONFIG_FS_ROMFS=y

# IOB chains
CONFIG_IOB_NCHAINS=4

# Network
CONFIG_NET=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_ICMP=y
CONFIG_NET_ICMP_PMTU_ENTRIES=0
CONFIG_NET_ICMP_PMTU_TIMEOUT=0
CONFIG_NET_IGMP=y
CONFIG_NET_STATISTICS=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_SOLINGER=y
CONFIG_NET_PKT=y
CONFIG_NET_PKT_PREALLOC_CONNS=1
CONFIG_NET_PKT_ALLOC_CONNS=0
CONFIG_NET_PKT_MAX_CONNS=0
CONFIG_NET_TCP_NPOLLWAITERS=2
CONFIG_NET_UDP_NPOLLWAITERS=2
CONFIG_NET_RECV_BUFSIZE=4160
CONFIG_NET_SEND_BUFSIZE=4160
CONFIG_NET_MAX_RECV_BUFSIZE=4160
CONFIG_NET_MAX_SEND_BUFSIZE=4160
CONFIG_NETDEV_IFINDEX=y
CONFIG_NET_IPv6=y
CONFIG_NET_IPv4=y
CONFIG_NET_BOUND_IF=y
CONFIG_NET_ETHERNET=y
CONFIG_NET_LL_GUARDSIZE=14
CONFIG_NETDEV_LATEINIT=y

# DNS / NetDB (required by NTP client)
CONFIG_NETDB=y
CONFIG_NETDB_DNS=y

# IOB (Input/Output Buffer)
CONFIG_MM_IOB=y
CONFIG_IOB_NBUFFERS=8
CONFIG_IOB_BUFSIZE=196
CONFIG_IOB_SECTION=""

# WiFi (ESP32-CAM has WiFi)
CONFIG_ESP32_WIFI=y
CONFIG_WPA2_PSK=y
CONFIG_WPA2_ENTERPRISE=n

# Bluetooth / BLE HID
CONFIG_ESP32_BT=y
CONFIG_ESP32_BT_RESERVE_DRAM=0

# Drivers
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_SPI=y
CONFIG_SDIO_DMA=y
CONFIG_MMCSD=y
CONFIG_WATCHDOG=y
CONFIG_WDT=y
CONFIG_ESP32_WDT=y
CONFIG_GPIO_IRQ=y

# I2S (ESP32-CAM has NO I2S hardware - using DAC only)
# Commented out to avoid build errors - uncomment if needed for development
# CONFIG_I2S=y
# CONFIG_ESP32_I2S=y
# CONFIG_ESP32_I2S0=y
# CONFIG_ESP32_I2S0_TX=y
# CONFIG_ESP32_I2S0_ROLE_MASTER=y

# Audio Framework (commented - ESP32-CAM uses DAC, not I2S audio)
# CONFIG_AUDIO=y
# CONFIG_AUDIO_DEV=y
# CONFIG_AUDIO_MULTI_SESSION=y
# CONFIG_AUDIO_MSGQ=y
# CONFIG_AUDIO_SHBUF_SIZE=1024

# DAC (CVBS video output on GPIO25, audio on GPIO26)
CONFIG_DAC=y
CONFIG_ESP32_DAC=y

# ADC (audio input on GPIO34)
CONFIG_ADC=y
CONFIG_ESP32_ADC=y

# RTC
CONFIG_RTC=y
CONFIG_RTC_DRIVER=y
CONFIG_RTC_FUNCTIONS=y
CONFIG_RTC_INIT=y
CONFIG_ESP32_RT_TIMER=y

# PWM (for backlight control)
CONFIG_PWM=y
CONFIG_ESP32_LEDC=y
CONFIG_ESP32_LEDC_TIM0_CHANNELS=1
CONFIG_ESP32_LEDC_CHANNEL0_PIN=0

# DMA
CONFIG_DMA=y
CONFIG_ESP32_DMA=y

# SPI (for SD card)
CONFIG_ESP32_SPI2=y
CONFIG_SPI_DRIVER=y

# UART
CONFIG_ESP32_UART0=y
CONFIG_STANDARD_SERIAL=y
CONFIG_DEV_CONSOLE=y
CONFIG_UART0_SERIAL_CONSOLE=y

# RAM
CONFIG_RAM_SIZE=114688
CONFIG_RAM_START=0x20000000

# LVGL (完整 GUI)
CONFIG_GRAPHICS_LVGL=y

# LVGL Fonts
CONFIG_LV_USE_FONT_MONTSERRAT_10=y
CONFIG_LV_USE_FONT_MONTSERRAT_12=y
CONFIG_LV_USE_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_FONT_MONTSERRAT_16=y
CONFIG_LV_USE_FONT_MONTSERRAT_18=y
CONFIG_LV_USE_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_FONT_MONTSERRAT_22=y
CONFIG_LV_USE_FONT_MONTSERRAT_24=y

# Retro Workstation - ESP32-CAM
CONFIG_ESP32_RETRO=y
CONFIG_RETRO_DISPLAY=y
CONFIG_RETRO_CVBS_DAC=y
CONFIG_RETRO_DISPLAY_WIDTH=640
CONFIG_RETRO_DISPLAY_HEIGHT=480
CONFIG_RETRO_DISPLAY_REFR_RATE=50
CONFIG_RETRO_DISPLAY_PALETTE_SIZE=256
CONFIG_RETRO_AUDIO=y
CONFIG_RETRO_AUDIO_DAC=y
CONFIG_RETRO_AUDIO_SAMPLE_RATE=44100
CONFIG_RETRO_INPUT_BLE_HID=y
CONFIG_RETRO_BLE_MAX_BOND=3
CONFIG_RETRO_BLE_DEVICE_NAME="ESP32-CAM"
CONFIG_RETRO_BLE_AUTO_CONNECT=y
CONFIG_RETRO_BLE_SCAN_TIMEOUT=10
CONFIG_RETRO_BLE_LED_PIN=4
CONFIG_RETRO_FSK=y
CONFIG_RETRO_FSK_BAUD=4800
CONFIG_RETRO_FSK_LOGIC0_FREQ=4800
CONFIG_RETRO_FSK_LOGIC1_FREQ=9600
CONFIG_RETRO_RTC=n
CONFIG_RETRO_WIFI=y
CONFIG_RETRO_WIFI_SSID=""
CONFIG_RETRO_WIFI_PASSWORD=""
CONFIG_RETRO_NTP=y
CONFIG_RETRO_NTP_SERVER="ntp.aliyun.com"
CONFIG_RETRO_NET=y
CONFIG_ESP32_RETRO_FIREWALL=y
CONFIG_ESP32_RETRO_MEMMON=y
CONFIG_RETRO_CRON=y
CONFIG_SCHED_CRON=y
CONFIG_CRON_CRONTAB="/sdcard/etc/crontab"
CONFIG_CRON_LOG="/sdcard/logs/cron.log"
CONFIG_ESP32_RETRO_SCRIPTS=y
# CONFIG_INTERPRETER_CPYTHON=y  # ESP32-CAM 资源不足，无法运行 CPython (需要 32MB Flash)
CONFIG_INTERPRETERS_BAS=y
CONFIG_INTERPRETERS_DUKTAPE=y

# Network Utils
CONFIG_NETUTILS_CURL=y
CONFIG_NETUTILS_WGET=y
# CONFIG_NETUTILS_NTPCLIENT=y  # 临时禁用，struct addrinfo 问题未解决
CONFIG_SYSTEM_PING=y
CONFIG_NETUTILS_DHCPD=y
CONFIG_NETUTILS_JSON=y
CONFIG_SYSTEM_TELNETD=y
CONFIG_SYSTEM_FTPD=y
CONFIG_SYSTEM_IFFCONF=y

# System Apps
CONFIG_SYSTEM_CLE=y
CONFIG_SYSTEM_EXPR=y
CONFIG_SYSTEM_YTEST=y

# SQLite
CONFIG_DATABASE_SQLITE3=y
CONFIG_SQLITE3_USING_MUTUAL=y

# C Library
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIBC_HEIMALLOCATION=y
CONFIG_MALLOC=y
CONFIG_SMART=y
CONFIG_MM_REGIONS=3
CONFIG_LIBC_MAX_EXITFUNS=0
CONFIG_LIBC_HOMEDIR="/home"
CONFIG_LIBC_TMPDIR="/tmp"
CONFIG_LIBC_CHATTR=y
CONFIG_LIBC_MUTEX_BACKTRACE=0
CONFIG_LIBC_STRERROR=y
CONFIG_LIBC_ERROR_STRING=y
CONFIG_ARCH_SETJMP_H=y

# Memory Management
CONFIG_MM_DEFAULT_MANAGER=y
CONFIG_MM_NODE_GUARDSIZE=32
CONFIG_MM_FREE_DELAYCOUNT_MAX=0
CONFIG_MM_BACKTRACE=0
CONFIG_MM_heap_alignment=8
CONFIG_MM_HEAP_MEMPOOL_THRESHOLD=0
CONFIG_MM_HEAP_BIGGEST_COUNT=0

# Pthread
CONFIG_PTHREAD_STACK_MIN=2048
CONFIG_PTHREAD_STACK_DEFAULT=16384
CONFIG_PTHREAD_GUARDSIZE_DEFAULT=4096
CONFIG_PTHREAD_ATTR_STACKADDR=y
CONFIG_PTHREAD_ATTR_STACKSIZE=y

# IRQ
CONFIG_IRQ_NWORKS=4
CONFIG_IRQ_WORK_STACKSIZE=2048
CONFIG_IRQ_WORK_SECTION=".irq_work"

# TLS
CONFIG_TLS_NCLEANUP=4

# Assert
CONFIG_ASSERT_PAUSE_CPU_TIMEOUT=100
CONFIG_ARCH_STACKDUMP_MAX_LENGTH=256

# Build Options
CONFIG_HOST_LINUX=y
CONFIG_BUILD_FLAT=y
CONFIG_RAW_BINARY=y
CONFIG_INT128=y
CONFIG_HAVE_LONG_LONG=y
CONFIG_BASE_DEFCONFIG="/home/user/retro-ws/configs/nuttx-defconfig-esp32cam-full"

# Stream Buffers
CONFIG_STREAM_OUT_BUFFER_SIZE=64
CONFIG_STREAM_HEXDUMP_BUFFER_SIZE=128
CONFIG_STREAM_BASE64_BUFFER_SIZE=128

# File Descriptors
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK=8

# Scheduling
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_PREALLOC_TIMERS=4
CONFIG_TASK_NAME_SIZE=32
CONFIG_PID_INITIAL_COUNT=64
CONFIG_SCHED_STACK_RECORD=0

# Message Queue
CONFIG_MQUEUE=y
CONFIG_MQUEUE_NMSGS=4
CONFIG_MQUEUE_MAXMSGSIZE=64
CONFIG_MQ_MAXMSGSIZE=64
CONFIG_DISABLE_MQUEUE=n
CONFIG_PREALLOC_MQ_MSGS=4
CONFIG_PREALLOC_MQ_IRQ_MSGS=2

# LibC
CONFIG_LIBC_FTOK_VFS_PATH="/dev"

# Init
CONFIG_INIT_ENTRYNAME="nsh_main"

# Signal
CONFIG_SIG_PREALLOC_ACTIONS=4
CONFIG_SIG_ALLOC_ACTIONS=1
CONFIG_SIG_PREALLOC_IRQ_ACTIONS=8

# System Info
CONFIG_START_DAY=6
CONFIG_START_MONTH=12
CONFIG_START_YEAR=2011
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSLOG_BUFSIZE=256
CONFIG_LINE_MAX=64

# CXX
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y

# ELF Support
CONFIG_BINFMT_LOADABLE=y
CONFIG_ELF=y
CONFIG_ELF_STACKSIZE=8192
CONFIG_BINFMT_STORE_FILENAME=y
CONFIG_LIBC_ELFFILE=y
CONFIG_LIBC_ELF=y
CONFIG_LIBC_ARCH_ELF=y
CONFIG_LIBC_ELF_RELOCATION_BUFFERCOUNT=8
CONFIG_LIBC_ELF_SYMBOL_CACHECOUNT=16

# Multicast Group
CONFIG_NET_MCASTGROUP=y

# TCP Port Randomization
CONFIG_NET_DEFAULT_MIN_PORT=1024
CONFIG_NET_DEFAULT_MAX_PORT=65535

# TCP Connections
CONFIG_NET_TCP_PREALLOC_CONNS=8
CONFIG_NET_TCP_ALLOC_CONNS=0
CONFIG_NET_TCP_MAX_CONNS=0

# UDP Connections
CONFIG_NET_UDP_PREALLOC_CONNS=8
CONFIG_NET_UDP_ALLOC_CONNS=0
CONFIG_NET_UDP_MAX_CONNS=0

# Device Callbacks
CONFIG_NET_PREALLOC_DEVIF_CALLBACKS=16
CONFIG_NET_ALLOC_DEVIF_CALLBACKS=0

# Sensors (I2C)
CONFIG_SENSORS=y

# FSBinary
CONFIG_BINFMT_FS=y
