# ESP32-S3 DevKitC-1 N8R8（8MB Flash 变体）——项目追加配置
# 双核分工：CPU0=程序(NSH/脚本)，CPU1=媒体(图形/视频/音频/文件IO)
CONFIG_RETRO=y
CONFIG_RETRO_PKG_MANAGER=y
CONFIG_RETRO_GPIO_SCRIPT=y
CONFIG_RETRO_PINYIN_CLI=y
CONFIG_RETRO_MEMMON=y
CONFIG_INIT_ENTRYPOINT="retro_boot_main"
CONFIG_INIT_STACKSIZE=4096
CONFIG_DEV_GPIO=y
CONFIG_DEV_GPIO_LOWER_HALF=y
CONFIG_ESP32S3_GPIO_IRQ=y
CONFIG_RETRO_ARCH="xtensa-esp32s3"
# SMP 双核
CONFIG_SMP=y
CONFIG_SPINLOCK=y
# N8R8：8MB Flash
# CONFIG_ESP32S3_FLASH_DETECT is not set
CONFIG_ESP32S3_FLASH_8M=y
CONFIG_RETRO_FLASH_8MB=y

# unset: CONFIG_ARCH_CHIP_ESP32S3WROOM1N4
# AV 视频字符控制台（全系标配，含全量 UTF-8 中文字库 911KB）
CONFIG_RETRO_AV_CONSOLE=y
# 脚本引擎（Berry + my-basic 默认入 ROM；Pico 2MB 档保底 Berry）
CONFIG_RETRO_SCRIPTS=y
CONFIG_RETRO_SCRIPT_BERRY=y
CONFIG_RETRO_SCRIPT_TINYBASIC=y
# Berry 依赖：setjmp（工具链实现）+ system()（apps/system/system）
CONFIG_ARCH_SETJMP_H=y
CONFIG_SYSTEM_SYSTEM=y
# 全栈：LVGL 图形界面 + CVBS 显示 + Duktape + jslogo
CONFIG_RETRO_GUI=y
CONFIG_RETRO_DISPLAY=y
CONFIG_LVGL=y
CONFIG_RETRO_SCRIPT_DUKTAPE=y
CONFIG_RETRO_SCRIPT_JSLOGO=y
# RAM：8MB Octal PSRAM（GUI 帧缓冲/大堆入 PSRAM，SRAM 只留实时）
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SPEED_80M=y
CONFIG_MM_REGIONS=2
CONFIG_RETRO_AUDIO=y
CONFIG_ESP32S3_I2S=y
# nano 正则搜索依赖（TRE 正则为 MIT 许可组件）
CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_LIBC_REGEX=y
# 全系标配升级（2026-10-04 晚）：nano 编辑器 + 总线兼容层 + 板级脚本 ROM 化
CONFIG_RETRO_NANO=y
CONFIG_RETRO_BUS=y
CONFIG_RETRO_SCRIPTS_ROM=y
CONFIG_FS_ROMFS=y

# 硬件外设升级（2026-10-04 晚，HARDWARE.md 13.1）：
# WS2812 状态灯走 RMT 真外设（/dev/rmt0，板级已绑 GPIO38/48）
CONFIG_RMT=y
CONFIG_RMTCHAR=y
CONFIG_ESP_RMT=y
# RTC/总线走硬件 I2C0（SCL=GPIO5 / SDA=GPIO6 -> /dev/i2c0）
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_ESP32S3_I2C=y
CONFIG_ESP32S3_I2C0=y
CONFIG_ESP32S3_I2C0_SCLPIN=5
CONFIG_ESP32S3_I2C0_SDAPIN=6
