# ESP32-S3 DevKitC-1 N16R8（首选开发模板）——项目追加配置
# 双核分工：CPU0=程序(NSH/脚本)，CPU1=媒体(图形/视频/音频/文件IO)
CONFIG_RETRO=y
CONFIG_RETRO_PKG_MANAGER=y
CONFIG_RETRO_GPIO_SCRIPT=y
CONFIG_RETRO_PINYIN_CLI=y
CONFIG_RETRO_MEMMON=y
CONFIG_INIT_ENTRYPOINT="retro_boot_main"
CONFIG_INIT_STACKSIZE=4096
CONFIG_DEV_GPIO=y
CONFIG_DEV_GPIO_LOWER_HALF=y
CONFIG_ESP32S3_GPIO_IRQ=y
CONFIG_RETRO_ARCH="xtensa-esp32s3"
# SMP 双核
CONFIG_SMP=y
CONFIG_SPINLOCK=y
# CONFIG_ESP32S3_FLASH_DETECT is not set
CONFIG_ESP32S3_FLASH_16M=y

# unset: CONFIG_ARCH_CHIP_ESP32S3WROOM1N4
# AV 视频字符控制台（全系标配，含全量 UTF-8 中文字库 911KB）
CONFIG_RETRO_AV_CONSOLE=y
# 脚本引擎（Berry + my-basic 默认入 ROM；Pico 2MB 档保底 Berry）
CONFIG_RETRO_SCRIPTS=y
CONFIG_RETRO_SCRIPT_BERRY=y
CONFIG_RETRO_SCRIPT_TINYBASIC=y
# Berry 依赖：setjmp（工具链实现）+ system()（apps/system/system）
CONFIG_ARCH_SETJMP_H=y
CONFIG_SYSTEM_SYSTEM=y
# 全栈：LVGL 图形界面 + CVBS 显示 + Duktape + jslogo
CONFIG_RETRO_GUI=y
CONFIG_RETRO_DISPLAY=y
CONFIG_LVGL=y
CONFIG_RETRO_SCRIPT_DUKTAPE=y
CONFIG_RETRO_SCRIPT_JSLOGO=y
# RAM：8MB Octal PSRAM（GUI 帧缓冲/大堆入 PSRAM，SRAM 只留实时）
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SPEED_80M=y
CONFIG_MM_REGIONS=2
CONFIG_RETRO_AUDIO=y
CONFIG_ESP32S3_I2S=y
# 编辑器正则支持（vi/nano 通用）
CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_LIBC_REGEX=y
# 网络管理层（2026-10-05 全量编入）：network.c + wifi_conf(/opt/etc/network.conf)
# + ntp + firewall(/opt/etc/firewall.conf)；静态 IP 依赖 netlib+dns（NEXT_STEPS 52 关单）
# 网络栈基础（板级 nsh defconfig 默认无网络；DNSCLIENT 依赖不会全拖齐）
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_BROADCAST=y
# 网络栈基础（2026-10-05）：socket/DNS/NTP 管理层全编入；WiFi 硬件驱动
CONFIG_SCHED_WORKQUEUE=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_HPWORK=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_RETRO_WIFI=y
CONFIG_RETRO_NTP=y
CONFIG_NETUTILS_NETLIB=y
CONFIG_NETUTILS_DNSCLIENT=y

# retro_gpio /dev 后端三件套（NEXT_STEPS 19a）：/dev/gpioN（LOWER_HALF 模式）
# + 芯片 ADC（ESP32S3_ADC -> /dev/adc0）+ LEDC PWM（-> /dev/pwm0）
# DEV_GPIO 原已开（文件头），此处补 ADC/PWM
CONFIG_ADC=y
CONFIG_ESP32S3_ADC=y
CONFIG_PWM=y
CONFIG_ESP32S3_LEDC=y

# S3 板本/模组（NEXT_STEPS 4，2026-10-05）：v1.1 量产板（WS2812=GPIO38，
# HARDWARE 2.8；树内 choice 默认是 v1.0/GPIO48，此处纠正）+ N16R8 模组
CONFIG_ESP32S3_DEVKITC_1_V11=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y

# 编辑器定稿（2026-10-05）：系统默认 vi（CONFIG_SYSTEM_VI）；GNU nano
# 为 GPL-3.0 不入 ROM，经 .rpk 包交付（apps-extra/nano，AGENTS 11.1 红线）
CONFIG_SYSTEM_VI=y
CONFIG_RETRO_BUS=y
CONFIG_RETRO_SCRIPTS_ROM=y
CONFIG_FS_ROMFS=y

# 硬件外设升级（2026-10-04 晚，HARDWARE.md 13.1）：
# WS2812 状态灯走 RMT 真外设（/dev/rmt0，板级已绑 GPIO38/48）
CONFIG_RMT=y
CONFIG_RMTCHAR=y
CONFIG_ESP_RMT=y
# RTC/总线走硬件 I2C0（SCL=GPIO5 / SDA=GPIO6 -> /dev/i2c0）
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_ESP32S3_I2C=y
CONFIG_ESP32S3_I2C0=y
CONFIG_ESP32S3_I2C0_SCLPIN=5
CONFIG_ESP32S3_I2C0_SDAPIN=6

# ROM 包存储 + 首启自动安装（应用/系统分离，2026-10-06）：
# 名单 firmware/packages/EOF

# ROM 包存储 + 首启自动安装（应用/系统分离，2026-10-06）：各板默认
# 应用名单（firmware/packages/<板>.list）构建期打包 .rpk 入 ROM，
# 首启 seed 自动安装；.rmo 模块 XIP 原址执行（HARDWARE.md 14 章）
CONFIG_RETRO_PKG_STORE=y

# ROM 模块 arena 入 PSRAM（2026-10-06 应用/系统分离）：开 NuttX
# XTENSA_EXTMEM_BSS 后 .ext_ram.bss 才会被链接脚本路由进 extern_ram_seg
# （PSRAM），否则 arena 大数组会孤儿段漂进 rtc_slow_seg 溢出
CONFIG_XTENSA_EXTMEM_BSS=y
