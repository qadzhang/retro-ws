# 合宙 ESP32-C3 核心板 CLI 档——项目追加配置
# 单核 RISC-V：程序+服务共核；UART0 控制台
CONFIG_RETRO=y
CONFIG_RETRO_PKG_MANAGER=y
CONFIG_RETRO_GPIO_SCRIPT=y
CONFIG_RETRO_PINYIN_CLI=y
CONFIG_RETRO_MEMMON=y
CONFIG_INIT_ENTRYPOINT="retro_boot_main"
CONFIG_INIT_STACKSIZE=4096
# 通用 GPIO 驱动（retro_gpio 后端）
CONFIG_DEV_GPIO=y
CONFIG_DEV_GPIO_LOWER_HALF=y
# RISC-V 包架构标识（.rpk Arch 三级匹配）
CONFIG_RETRO_ARCH="riscv-esp32c3"
CONFIG_ESPRESSIF_GPIO_IRQ=y
# AV 视频字符控制台（全系标配，含全量 UTF-8 中文字库 911KB）
CONFIG_RETRO_AV_CONSOLE=y
# NSH 跑 AV 屏（/dev/cvbscon；UART0 只作键盘输入）
CONFIG_RETRO_AV_INPUT=y
CONFIG_NSH_ALTCONDEV=y
CONFIG_NSH_CONDEV="/dev/cvbscon"
# 控制台分辨率档：320x240（240p，fb 75KB 适配 400KB SRAM）
CONFIG_RETRO_DISPLAY_WIDTH=320
CONFIG_RETRO_DISPLAY_HEIGHT=240
# 脚本引擎（Berry + my-basic 默认入 ROM；Pico 2MB 档保底 Berry）
CONFIG_RETRO_SCRIPTS=y
CONFIG_RETRO_SCRIPT_BERRY=y
CONFIG_RETRO_SCRIPT_TINYBASIC=y
# Berry 依赖：setjmp（工具链实现）+ system()（apps/system/system）
CONFIG_ARCH_SETJMP_H=y
CONFIG_SYSTEM_SYSTEM=y
# CLI 全家桶：Duktape(JS) + 行编辑器 + 文件/网络工具
CONFIG_RETRO_SCRIPT_DUKTAPE=y
# CLI 全家桶（nuttx-apps 预移植程序）
CONFIG_SYSTEM_CLE=y
CONFIG_NSH_CLE=y
CONFIG_SYSTEM_DD=y
CONFIG_SYSTEM_TEE=y
CONFIG_FSUTILS_MKRD=y
CONFIG_SYSTEM_HEXED=y
# 编辑器：系统 vi（行编辑依赖 readline）
CONFIG_SYSTEM_READLINE=y
CONFIG_EXAMPLES_HELLO=y
# 编辑器正则支持（vi/nano 通用）
CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_LIBC_REGEX=y
# 网络管理层（2026-10-05 全量编入）：network.c + wifi_conf(/opt/etc/network.conf)
# + ntp + firewall(/opt/etc/firewall.conf)；静态 IP 依赖 netlib+dns（NEXT_STEPS 52 关单）
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_UDP=y
CONFIG_NET_TCP=y
CONFIG_NET_BROADCAST=y
CONFIG_NET_ICMP=y
# 网络栈基础（2026-10-05）：socket/DNS/NTP 管理层全编入；WiFi 硬件驱动
CONFIG_SCHED_WORKQUEUE=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_HPWORK=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_RETRO_WIFI=y
CONFIG_RETRO_NTP=y
CONFIG_NETUTILS_NETLIB=y
CONFIG_NETUTILS_DNSCLIENT=y

# 编辑器定稿（2026-10-05）：系统默认 vi（CONFIG_SYSTEM_VI）；GNU nano
# 为 GPL-3.0 不入 ROM，经 .rpk 包交付（apps-extra/nano，AGENTS 11.1 红线）
CONFIG_SYSTEM_VI=y
CONFIG_RETRO_BUS=y
CONFIG_RETRO_SCRIPTS_ROM=y
CONFIG_FS_ROMFS=y
