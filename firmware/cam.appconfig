# ESP32-CAM（AI-Thinker，WROVER 4MB）兼容档——项目追加配置
CONFIG_RETRO=y
CONFIG_RETRO_PKG_MANAGER=y
CONFIG_RETRO_GPIO_SCRIPT=y
CONFIG_RETRO_PINYIN_CLI=y
CONFIG_RETRO_MEMMON=y
CONFIG_INIT_ENTRYPOINT="retro_boot_main"
CONFIG_INIT_STACKSIZE=4096
CONFIG_DEV_GPIO=y
CONFIG_DEV_GPIO_LOWER_HALF=y
CONFIG_ESP32_GPIO_IRQ=y
CONFIG_RETRO_ARCH="xtensa-esp32"
# 双核分工：CPU0=程序，CPU1=媒体（LX6 双核）
# SMP 依赖 ARCH_INTERRUPTSTACK != 0
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2
# AV 视频字符控制台（全系标配，含全量 UTF-8 中文字库 911KB）
CONFIG_RETRO_AV_CONSOLE=y
# 脚本引擎（Berry + my-basic 默认入 ROM；Pico 2MB 档保底 Berry）
CONFIG_RETRO_SCRIPTS=y
CONFIG_RETRO_SCRIPT_BERRY=y
CONFIG_RETRO_SCRIPT_TINYBASIC=y
# Berry 依赖：setjmp（工具链实现）+ system()（apps/system/system）
CONFIG_ARCH_SETJMP_H=y
CONFIG_SYSTEM_SYSTEM=y
# 全栈：LVGL 图形界面 + CVBS 显示 + Duktape + jslogo
CONFIG_RETRO_GUI=y
CONFIG_RETRO_DISPLAY=y
CONFIG_LVGL=y
CONFIG_RETRO_SCRIPT_DUKTAPE=y
CONFIG_RETRO_SCRIPT_JSLOGO=y
# RAM：WROVER 4MB PSRAM（GUI 帧缓冲/大堆入 PSRAM）
CONFIG_ESP32_SPIRAM=y
CONFIG_ESP32_SPIRAM_SPEED_40M=y
CONFIG_MM_REGIONS=2
CONFIG_RETRO_AUDIO=y
CONFIG_ESP32_I2S=y
CONFIG_RETRO_AUDIO_DAC=y
# 编辑器正则支持（vi/nano 通用）
CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_LIBC_REGEX=y
# 编辑器定稿（2026-10-05）：系统默认 vi（CONFIG_SYSTEM_VI）；GNU nano
# 为 GPL-3.0 不入 ROM，经 .rpk 包交付（apps-extra/nano，AGENTS 11.1 红线）
CONFIG_SYSTEM_VI=y
CONFIG_RETRO_BUS=y
CONFIG_RETRO_SCRIPTS_ROM=y
CONFIG_FS_ROMFS=y

# 硬件外设升级（2026-10-04 晚，HARDWARE.md 13.1）：
# RTC/总线走硬件 I2C0（SCL=GPIO22 / SDA=GPIO21 -> /dev/i2c0）
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_ESP32_I2C=y
CONFIG_ESP32_I2C0=y
CONFIG_ESP32_I2C0_SCLPIN=22
CONFIG_ESP32_I2C0_SDAPIN=21
