# Raspberry Pi Pico（RP2040）本地 CLI 档——项目追加配置
# 双核分工：Core0=程序(NSH/脚本)，Core1=文件IO 服务（SMP）
CONFIG_RETRO=y
CONFIG_RETRO_PKG_MANAGER=y
CONFIG_RETRO_GPIO_SCRIPT=y
CONFIG_RETRO_PINYIN_CLI=y
CONFIG_INIT_ENTRYPOINT="retro_boot_main"
CONFIG_INIT_STACKSIZE=4096
# UF2 由宿主脚本 scripts/make_uf2.py 生成（免 picotool/pico-sdk 依赖）
# CONFIG_RP2040_UF2_BINARY is not set
CONFIG_RP2040_UF2_BINARY=n
# 通用 GPIO 驱动（retro_gpio 后端：/dev/gpioN + GPIOC_* ioctl）
CONFIG_DEV_GPIO=y
CONFIG_DEV_GPIO_LOWER_HALF=y
CONFIG_RP2040_GPIO_IRQ=y
# 双核分工：Core0=程序(NSH/脚本)，Core1=文件IO 服务
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2
# AV 视频字符控制台（全系标配，含全量 UTF-8 中文字库 911KB）
CONFIG_RETRO_AV_CONSOLE=y
# PIO-USB 主机键盘（输入优先级 USB>串口 落地；MIT，上游出处见
# src/nuttx/rp2040/driver/input/pio_usb/README.md；占 PIO1+DMA0+GP20/21）
CONFIG_RETRO_PIO_USB=y
# NSH 跑 AV 屏（PIO 视频上；UART0 只作键盘输入）
CONFIG_RETRO_AV_INPUT=y
CONFIG_NSH_ALTCONDEV=y
CONFIG_NSH_CONDEV="/dev/cvbscon"
# 控制台分辨率档：320x240（240p，fb 75KB 适配 264KB SRAM）
CONFIG_RETRO_DISPLAY_WIDTH=320
CONFIG_RETRO_DISPLAY_HEIGHT=240
# 脚本引擎（Berry + my-basic 默认入 ROM；Pico 2MB 档保底 Berry）
CONFIG_RETRO_SCRIPTS=y
CONFIG_RETRO_SCRIPT_BERRY=y
CONFIG_RETRO_SCRIPT_TINYBASIC=y
# Berry 依赖：setjmp（工具链实现）+ system()（apps/system/system）
CONFIG_ARCH_SETJMP_H=y
CONFIG_SYSTEM_SYSTEM=y
# 编辑器正则支持（vi/nano 通用）
CONFIG_ALLOW_MIT_COMPONENTS=y
CONFIG_LIBC_REGEX=y
# ADC + PWM 补开（NEXT_STEPS 19a；DEV_GPIO 原已开）
CONFIG_ADC=y
CONFIG_RP2040_ADC=y
CONFIG_PWM=y
CONFIG_RP2040_PWM=y

# 编辑器定稿（2026-10-05）：系统默认 vi（CONFIG_SYSTEM_VI）；GNU nano
# 为 GPL-3.0 不入 ROM，经 .rpk 包交付（apps-extra/nano，AGENTS 11.1 红线）
CONFIG_SYSTEM_VI=y
CONFIG_RETRO_BUS=y
CONFIG_RETRO_SCRIPTS_ROM=y
CONFIG_FS_ROMFS=y
